# Application Environment
APP_ENVIRONMENT=Production
APP_PORT=5002

# Database Provider: 'postgresql' or 'sqlite'
DATABASE_PROVIDER=postgresql

# PostgreSQL Connection Parameters (for Docker Compose or external DB)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=jeevika_db_v2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_strong_password_in_production

# Direct Database Connection String (optional override)
